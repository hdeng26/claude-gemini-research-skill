# gemini-research config. Lives at ~/.gemini-research/config.env (chmod 600).
# A paid-tier key is recommended: free-tier quota for Google Search grounding is very small,
# and free-tier content may be used by Google to improve its products.
GEMINI_API_KEY=

# Model (optional). Default gemini-3.8-flash. gemini-4-hydrogen also has a price table;
# measured 2026-11-13 it cost ~3-6x more per scout than 3.8 Flash at similar speed.
# GEMINI_MODEL=gemini-3.8-flash

# Budget caps (USD / Google search queries)
MONTHLY_CAP_USD=15
DAILY_SOFT_CAP_USD=2
MONTHLY_SEARCH_QUERY_CAP=4500
